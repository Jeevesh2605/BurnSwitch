# Copy to .env and fill in. Never commit .env.

# --- LocalStack (default mode, no real AWS) ---
# The LocalStack image now requires an auth token (free plan for non-commercial use):
# https://app.localstack.cloud/settings/auth-tokens
LOCALSTACK_AUTH_TOKEN=
AWS_REGION=us-east-1
# LocalStack accepts any credentials; these dummies are only used in LocalStack mode.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack, from the host: http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566

# --- Switch ---
# Agent bridge base URL (NOT the Gateway URL). Verify with: curl $SWITCH_BRIDGE_URL/health
SWITCH_BRIDGE_URL=
# Registration key (Gateway > API Keys, type "registration"). Used once, by the register script.
SWITCH_REGISTRATION_KEY=
# Filled in by the register script. The API key is shown only once.
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
# The #finops-control room id
SWITCH_ROOM_ID=

# --- Watchdog ---
# Who approves live changes; named in the alert. Use your chat username.
ONCALL_NAME=
# Agent the watchdog hands incidents to (addressed once per incident).
HANDOFF_AGENT=claude-code
# localstack-probe (default) | cloudwatch | replay
METRICS_SOURCE=localstack-probe
# For METRICS_SOURCE=replay; defaults to watchdog/fixtures/storm.json
REPLAY_FIXTURE=
# Tests: log posts instead of sending them (1), and keep state in another folder.
WATCHDOG_DRY_RUN=
WATCHDOG_STATE_DIR=
# Where Switch Console records its local server's ports (default: the macOS location).
SWITCH_CONSOLE_PORTS=

# --- Real AWS (only with --real-aws on a command) ---
# AWS CLI profile to use; otherwise your default credentials. The dummy "test" keys above
# are ignored in real mode.
REAL_AWS_PROFILE=
