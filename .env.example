# Copy to .env and fill in. Never commit .env.

# --- LocalStack (default mode, no real AWS) ---
# The LocalStack image now requires an auth token (free plan for non-commercial use):
# https://app.localstack.cloud/settings/auth-tokens
LOCALSTACK_AUTH_TOKEN=
AWS_REGION=us-east-1
# LocalStack accepts any credentials; these dummies are only used in LocalStack mode.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# From the host: http://localhost:4566. Inside docker compose: http://localstack:4566
AWS_ENDPOINT_URL=http://localhost:4566

# --- Switch ---
# Agent bridge base URL (NOT the Gateway URL). Verify with: curl $SWITCH_BRIDGE_URL/health
SWITCH_BRIDGE_URL=
# Registration key (Gateway > API Keys, type "registration"). Used once, by the register script.
SWITCH_REGISTRATION_KEY=
# Filled in by the register script. The API key is shown only once.
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
# The #finops-control room id
SWITCH_ROOM_ID=
