#!/usr/bin/env bash
# Builds scenario/order-worker and deploys it to the order-worker Lambda (LocalStack, or real
# AWS if scenario:up ran with --real-aws).
# A live change: run it only after the on-call human approves in the room.
export BURNSWITCH_FOLLOW_TARGET=1 # act where scenario:up put the scenario (.state/target)
export CHANGE_SOURCE=agent # changes made through here are incident actions (need approval)
source "$(dirname "$0")/../infra/lib.sh" "$@"
deploy_worker
awsl lambda get-function-configuration --function-name "$FUNCTION" \
  --query '{function: FunctionName, codeSha256: CodeSha256, lastModified: LastModified}'
